# Line endings. Required by _plan/08-infrastructure-and-build.md §12 ("Determinism"):
# without this, core.autocrlf on Windows changes every file's sha256 between machines
# and `bench verify --commit <sha>` fails for a reason unrelated to the build. The
# maintainer's environment is Windows, so this is a live condition, not a hypothetical.

* text=auto eol=lf

*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.toml text eol=lf

# Binary: never normalise. .npz is the Atlas projection basis (10 §"drift gate"),
# .woff2 the subset IBM Plex faces (09 §"type").
*.npz   binary
*.woff2 binary
*.woff  binary
*.png   binary
*.jpg   binary
*.webp  binary
*.pdf   binary

# Captured upstream responses are byte-exact ("strip nothing", P5-S1-T02): never normalise them.
# Each body's sha256 is recorded in its <name>.headers.json and checked by the fixture tests.
tests/ingest/fixtures/** -text
