---
// A placeholder page. Its two chip rows are what test/config.test.mjs checks in the built HTML.
// Observed on 7.3.3 (2026-09-24): compressHTML: 'jsx' keeps a space written on one line (the
// second row) but removes whitespace that contains a line break (the first row), so a row written
// one element per line -- the shape components produce -- renders as "robotics-embodimentmanipulation".
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Benchmark index</title>
  </head>
  <body>
    <main>
      <h1>Benchmark index</h1>
      <p class="chips" data-test="chip-row">
        <span class="chip">robotics-embodiment</span>
        <span class="chip">manipulation</span>
        <em class="badge">unreviewed</em>
      </p>
      <p class="chips" data-test="chip-row-inline"><span class="chip">code</span> <span class="chip">agents</span></p>
    </main>
  </body>
</html>
