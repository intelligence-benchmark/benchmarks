{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bench schema gen` from schema/*.py and taxonomy/*.yaml. Do not edit.",
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^org-[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "kind": {
      "enum": [
        "academic-lab",
        "company",
        "government-agency",
        "non-profit",
        "community",
        "consortium",
        "individual"
      ],
      "title": "Kind",
      "type": "string"
    },
    "parent": {
      "anyOf": [
        {
          "pattern": "^org-[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent"
    },
    "country": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Country"
    },
    "homepage": {
      "anyOf": [
        {
          "pattern": "^https?://\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Homepage"
    },
    "ror": {
      "anyOf": [
        {
          "pattern": "^https://ror\\.org/0[a-z0-9]{8}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ror"
    },
    "wikidata": {
      "anyOf": [
        {
          "pattern": "^Q[1-9]\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wikidata"
    },
    "roles": {
      "items": {
        "enum": [
          "benchmark-maintainer",
          "system-developer",
          "evaluator",
          "funder"
        ],
        "type": "string"
      },
      "title": "Roles",
      "type": "array"
    },
    "sources": {
      "items": {
        "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "sources"
  ],
  "title": "Organization",
  "type": "object"
}
