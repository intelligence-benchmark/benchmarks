{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bench schema gen` from schema/*.py and taxonomy/*.yaml. Do not edit.",
  "$defs": {
    "Erratum": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "scope": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source": {
          "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "description",
        "source"
      ],
      "title": "Erratum",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Version",
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "version_kind": {
      "default": "revision",
      "enum": [
        "revision",
        "edition",
        "track-set"
      ],
      "title": "Version Kind",
      "type": "string"
    },
    "released": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Released"
    },
    "items": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Items"
    },
    "changes": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Changes"
    },
    "breaking": {
      "default": false,
      "title": "Breaking",
      "type": "boolean"
    },
    "supersedes_version": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Version"
    },
    "superseded_by": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By"
    },
    "errata": {
      "items": {
        "$ref": "#/$defs/Erratum"
      },
      "title": "Errata",
      "type": "array"
    },
    "frozen": {
      "default": true,
      "title": "Frozen",
      "type": "boolean"
    },
    "sources": {
      "items": {
        "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "version"
  ],
  "title": "BenchmarkVersion",
  "type": "object"
}
