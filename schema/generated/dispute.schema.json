{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bench schema gen` from schema/*.py and taxonomy/*.yaml. Do not edit.",
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^dispute-[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "concerns": {
      "pattern": "^claim-[0-9a-f]{12}$",
      "title": "Concerns",
      "type": "string"
    },
    "raised_by": {
      "minLength": 1,
      "title": "Raised By",
      "type": "string"
    },
    "disputant_relationship": {
      "enum": [
        "evaluated-party",
        "benchmark-maintainer",
        "third-party",
        "unknown"
      ],
      "title": "Disputant Relationship",
      "type": "string"
    },
    "raised_on": {
      "format": "date",
      "title": "Raised On",
      "type": "string"
    },
    "position": {
      "minLength": 1,
      "title": "Position",
      "type": "string"
    },
    "evidence": {
      "items": {
        "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "claim_sources": {
      "items": {
        "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Claim Sources",
      "type": "array"
    },
    "our_response": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Our Response"
    },
    "status": {
      "default": "open",
      "enum": [
        "open",
        "resolved-claim-corrected",
        "resolved-claim-retained",
        "withdrawn"
      ],
      "title": "Status",
      "type": "string"
    },
    "resolved_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved On"
    },
    "corrected_by": {
      "anyOf": [
        {
          "pattern": "^claim-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corrected By"
    }
  },
  "required": [
    "id",
    "concerns",
    "raised_by",
    "disputant_relationship",
    "raised_on",
    "position",
    "evidence",
    "claim_sources"
  ],
  "title": "Dispute",
  "type": "object"
}
