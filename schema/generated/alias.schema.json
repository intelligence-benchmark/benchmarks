{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bench schema gen` from schema/*.py and taxonomy/*.yaml. Do not edit.",
  "additionalProperties": false,
  "properties": {
    "alias": {
      "minLength": 1,
      "title": "Alias",
      "type": "string"
    },
    "resolves_to": {
      "pattern": "^(system|benchmark|organization):[a-z0-9][a-z0-9.-]*$",
      "title": "Resolves To",
      "type": "string"
    },
    "extracts": {
      "additionalProperties": true,
      "title": "Extracts",
      "type": "object"
    },
    "kind": {
      "enum": [
        "exact",
        "spelling",
        "provider-endpoint",
        "legacy-name",
        "typo"
      ],
      "title": "Kind",
      "type": "string"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "decided_by": {
      "minLength": 1,
      "title": "Decided By",
      "type": "string"
    },
    "decided_on": {
      "format": "date",
      "title": "Decided On",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    }
  },
  "required": [
    "alias",
    "resolves_to",
    "kind",
    "confidence",
    "decided_by",
    "decided_on"
  ],
  "title": "Alias",
  "type": "object"
}
