{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bench schema gen` from schema/*.py and taxonomy/*.yaml. Do not edit.",
  "$defs": {
    "ClaimExternalIds": {
      "additionalProperties": false,
      "properties": {
        "eee_result_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eee Result Id"
        }
      },
      "title": "ClaimExternalIds",
      "type": "object"
    },
    "Ingestion": {
      "additionalProperties": false,
      "description": "04 S9: present on every machine-written record, null on hand-curated ones.",
      "properties": {
        "batch": {
          "pattern": "^ingest-[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Batch",
          "type": "string"
        },
        "source_adapter": {
          "minLength": 1,
          "title": "Source Adapter",
          "type": "string"
        },
        "adapter_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Adapter Version",
          "type": "string"
        },
        "source_record_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Record Id"
        },
        "last_seen_upstream": {
          "format": "date",
          "title": "Last Seen Upstream",
          "type": "string"
        },
        "source_url": {
          "pattern": "^https?://\\S+$",
          "title": "Source Url",
          "type": "string"
        },
        "source_licence": {
          "minLength": 1,
          "title": "Source Licence",
          "type": "string"
        },
        "licence_class": {
          "enum": [
            "permissive-attribution",
            "share-alike",
            "non-commercial",
            "no-redistribution",
            "unlicensed"
          ],
          "title": "Licence Class",
          "type": "string"
        },
        "source_attribution": {
          "minLength": 1,
          "title": "Source Attribution",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "extraction_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Extraction Confidence",
          "type": "number"
        },
        "review_state": {
          "default": "machine-ingested",
          "enum": [
            "machine-ingested",
            "spot-checked",
            "human-reviewed",
            "promoted"
          ],
          "title": "Review State",
          "type": "string"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "reviewed_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed On"
        },
        "field_provenance": {
          "patternProperties": {
            "^[a-z_]+(\\.[a-z_]+)*$": {
              "enum": [
                "source",
                "derived",
                "absent",
                "curator"
              ],
              "type": "string"
            }
          },
          "title": "Field Provenance",
          "type": "object"
        }
      },
      "required": [
        "batch",
        "source_adapter",
        "adapter_version",
        "source_record_id",
        "last_seen_upstream",
        "source_url",
        "source_licence",
        "licence_class",
        "source_attribution",
        "ingested_at",
        "extraction_confidence"
      ],
      "title": "Ingestion",
      "type": "object"
    },
    "ProvenanceSnapshot": {
      "additionalProperties": false,
      "description": "04 S7: the upstream record exactly as retrieved. Small by design -- an Epoch row is a few\nhundred bytes.",
      "properties": {
        "source_record_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Record Id"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "raw": {
          "additionalProperties": true,
          "title": "Raw",
          "type": "object"
        }
      },
      "required": [
        "source_record_id",
        "retrieved_at",
        "content_sha256",
        "raw"
      ],
      "title": "ProvenanceSnapshot",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "stderr",
            "ci95",
            "ci90",
            "range",
            "iqr",
            "none"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "n_runs": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Runs"
        }
      },
      "required": [
        "type"
      ],
      "title": "Uncertainty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^claim-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "system": {
      "pattern": "^[a-z0-9][a-z0-9.-]{0,62}(@[A-Za-z0-9][A-Za-z0-9._-]*)?$",
      "title": "System",
      "type": "string"
    },
    "benchmark": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}(@[a-z0-9][a-z0-9._-]*)?$",
      "title": "Benchmark",
      "type": "string"
    },
    "subset": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subset"
    },
    "metric": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Metric",
      "type": "string"
    },
    "claim_type": {
      "default": "absolute",
      "enum": [
        "absolute",
        "pairwise",
        "rating",
        "ordinal",
        "qualitative"
      ],
      "title": "Claim Type",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "value_text": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value Text"
    },
    "opponent": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9.-]{0,62}(@[A-Za-z0-9][A-Za-z0-9._-]*)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Opponent"
    },
    "rating_pool": {
      "anyOf": [
        {
          "pattern": "^pool-[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rating Pool"
    },
    "uncertainty": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uncertainty"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "serving_provider": {
      "anyOf": [
        {
          "pattern": "^org-[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Serving Provider"
    },
    "date_reported": {
      "format": "date",
      "title": "Date Reported",
      "type": "string"
    },
    "reported_by": {
      "pattern": "^org-[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Reported By",
      "type": "string"
    },
    "verification": {
      "enum": [
        "self-reported",
        "maintainer-verified",
        "independent-reproduction",
        "held-out-server",
        "prospective-experiment",
        "third-party-audited",
        "sandboxed-rerun"
      ],
      "title": "Verification",
      "type": "string"
    },
    "disputed_by": {
      "items": {
        "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Disputed By",
      "type": "array"
    },
    "resolution_status": {
      "default": "resolved",
      "enum": [
        "pending",
        "partial",
        "resolved"
      ],
      "title": "Resolution Status",
      "type": "string"
    },
    "resolved_as_of": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved As Of"
    },
    "source": {
      "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Source",
      "type": "string"
    },
    "artifact_url": {
      "anyOf": [
        {
          "pattern": "^https?://\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Url"
    },
    "artifact_archived": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Archived"
    },
    "provenance_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProvenanceSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "external_ids": {
      "$ref": "#/$defs/ClaimExternalIds"
    },
    "eval_conditions": {
      "anyOf": [
        {
          "pattern": "^cond-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eval Conditions"
    },
    "result_group": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Group"
    },
    "superseded_by": {
      "anyOf": [
        {
          "pattern": "^claim-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By"
    },
    "ingestion": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ingestion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "id",
    "system",
    "benchmark",
    "metric",
    "date_reported",
    "reported_by",
    "verification",
    "source"
  ],
  "title": "ResultClaim",
  "type": "object"
}
