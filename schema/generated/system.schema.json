{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bench schema gen` from schema/*.py and taxonomy/*.yaml. Do not edit.",
  "$defs": {
    "SystemVersion": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Version",
          "type": "string"
        },
        "released": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Released"
        },
        "api_identifier": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Identifier"
        },
        "deprecated": {
          "default": false,
          "title": "Deprecated",
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "version"
      ],
      "title": "SystemVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "organization": {
      "anyOf": [
        {
          "pattern": "^org-[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Organization"
    },
    "system_type": {
      "enum": [
        "base-model",
        "instruction-tuned-model",
        "reasoning-model",
        "tool-augmented-model",
        "domain-specialist-model",
        "generative-media-model",
        "scientific-surrogate-model",
        "retrieval-augmented-system",
        "agent-scaffold",
        "multi-agent-system",
        "full-product-pipeline",
        "hosted-inference-endpoint",
        "rl-policy",
        "classical-algorithm",
        "physical-robot-system",
        "human-expert",
        "human-nonexpert",
        "human-ai-team"
      ],
      "title": "System Type",
      "type": "string"
    },
    "modalities_in": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Modalities In",
      "type": "array"
    },
    "modalities_out": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Modalities Out",
      "type": "array"
    },
    "open_weights": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Open Weights"
    },
    "license": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "license_class": {
      "anyOf": [
        {
          "enum": [
            "api-access",
            "hosted-no-api",
            "open-unrestricted",
            "open-restricted",
            "open-noncommercial",
            "unreleased"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License Class"
    },
    "api_identifier": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Api Identifier"
    },
    "first_released": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Released"
    },
    "built_on": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9.-]{0,62}(@[A-Za-z0-9][A-Za-z0-9._-]*)?$",
        "type": "string"
      },
      "title": "Built On",
      "type": "array"
    },
    "parameters_disclosed": {
      "default": false,
      "title": "Parameters Disclosed",
      "type": "boolean"
    },
    "parameter_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parameter Count"
    },
    "training_compute_disclosed": {
      "default": false,
      "title": "Training Compute Disclosed",
      "type": "boolean"
    },
    "training_compute_flop": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Compute Flop"
    },
    "training_compute_estimated": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Compute Estimated"
    },
    "training_compute_notes": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Compute Notes"
    },
    "availability": {
      "enum": [
        "generally-available",
        "limited-preview",
        "research-only",
        "deprecated",
        "retired",
        "never-released"
      ],
      "title": "Availability",
      "type": "string"
    },
    "retired_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retired On"
    },
    "external_ids": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "External Ids",
      "type": "object"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/SystemVersion"
      },
      "title": "Versions",
      "type": "array"
    },
    "sources": {
      "items": {
        "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "system_type",
    "availability",
    "sources"
  ],
  "title": "System",
  "type": "object"
}
