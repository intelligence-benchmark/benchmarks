{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bench schema gen` from schema/*.py and taxonomy/*.yaml. Do not edit.",
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^pool-[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "leaderboard": {
      "anyOf": [
        {
          "pattern": "^lb-[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Leaderboard"
    },
    "benchmark": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}(@[a-z0-9][a-z0-9._-]*)?$",
      "title": "Benchmark",
      "type": "string"
    },
    "snapshot_date": {
      "format": "date",
      "title": "Snapshot Date",
      "type": "string"
    },
    "members": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9.-]{0,62}(@[A-Za-z0-9][A-Za-z0-9._-]*)?$",
        "type": "string"
      },
      "minItems": 2,
      "title": "Members",
      "type": "array"
    },
    "games_per_pair": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Games Per Pair"
    },
    "rating_system": {
      "enum": [
        "elo",
        "bradley-terry",
        "trueskill",
        "glicko"
      ],
      "title": "Rating System",
      "type": "string"
    },
    "anchor": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9.-]{0,62}(@[A-Za-z0-9][A-Za-z0-9._-]*)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Anchor"
    },
    "sources": {
      "items": {
        "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "id",
    "benchmark",
    "snapshot_date",
    "members",
    "rating_system",
    "sources"
  ],
  "title": "RatingPool",
  "type": "object"
}
