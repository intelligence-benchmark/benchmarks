{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bench schema gen` from schema/*.py and taxonomy/*.yaml. Do not edit.",
  "$defs": {
    "ArchivedSnapshot": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "pattern": "^https?://\\S+$",
          "title": "Url",
          "type": "string"
        },
        "captured": {
          "format": "date",
          "title": "Captured",
          "type": "string"
        }
      },
      "required": [
        "url",
        "captured"
      ],
      "title": "ArchivedSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^lb-[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "host_org": {
      "anyOf": [
        {
          "pattern": "^org-[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Host Org"
    },
    "url": {
      "anyOf": [
        {
          "pattern": "^https?://\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "form": {
      "enum": [
        "live-table",
        "periodic-snapshot",
        "assessment-paper",
        "none"
      ],
      "title": "Form",
      "type": "string"
    },
    "benchmarks": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Benchmarks",
      "type": "array"
    },
    "submission_process": {
      "anyOf": [
        {
          "enum": [
            "self-reported",
            "maintainer-verified",
            "sandboxed-rerun",
            "held-out-server",
            "containerized-algorithm-submission",
            "assessment-committee",
            "third-party-audited",
            "live-arena",
            "physical-competition",
            "publication-gated"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission Process"
    },
    "is_live": {
      "title": "Is Live",
      "type": "boolean"
    },
    "last_updated": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Updated"
    },
    "archived_snapshots": {
      "items": {
        "$ref": "#/$defs/ArchivedSnapshot"
      },
      "title": "Archived Snapshots",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "form",
    "benchmarks",
    "is_live"
  ],
  "title": "Leaderboard",
  "type": "object"
}
