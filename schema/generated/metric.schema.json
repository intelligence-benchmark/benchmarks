      "default": null,
      "title": "Full Name"
    },
    "definition": {
      "minLength": 1,
      "title": "Definition",
      "type": "string"
    },
    "formula_reference": {
      "anyOf": [
        {
          "pattern": "^https?://\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Formula Reference"
    },
    "value_type": {
      "enum": [
        "ratio",
        "count",
        "duration",
        "currency",
        "elo",
        "ordinal",
        "categorical",
        "vector",
        "qualitative"
      ],
      "title": "Value Type",
      "type": "string"
    },
    "range": {
      "anyOf": [
        {
          "$ref": "#/$defs/Range"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unbounded": {
      "default": false,
      "title": "Unbounded",
      "type": "boolean"
    },
    "optimum": {
      "enum": [
        "max",
        "min",
        "zero",
        "target"
      ],
      "title": "Optimum",
      "type": "string"
    },
    "optimum_target": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Optimum Target"
    },
    "chance_baseline": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
