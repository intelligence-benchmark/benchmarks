{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bench schema gen` from schema/*.py and taxonomy/*.yaml. Do not edit.",
  "$defs": {
    "BatchLicence": {
      "additionalProperties": false,
      "properties": {
        "spdx": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spdx"
        },
        "class": {
          "enum": [
            "permissive-attribution",
            "share-alike",
            "non-commercial",
            "no-redistribution",
            "unlicensed"
          ],
          "title": "Class",
          "type": "string"
        },
        "redistribution_permitted": {
          "title": "Redistribution Permitted",
          "type": "boolean"
        },
        "share_alike": {
          "title": "Share Alike",
          "type": "boolean"
        },
        "non_commercial": {
          "title": "Non Commercial",
          "type": "boolean"
        },
        "attribution_required": {
          "title": "Attribution Required",
          "type": "boolean"
        },
        "attribution_text": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution Text"
        },
        "source_record": {
          "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Source Record",
          "type": "string"
        }
      },
      "required": [
        "class",
        "redistribution_permitted",
        "share_alike",
        "non_commercial",
        "attribution_required",
        "source_record"
      ],
      "title": "BatchLicence",
      "type": "object"
    },
    "BatchSource": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "pattern": "^https?://\\S+$",
          "title": "Url",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "http_etag": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Etag"
        },
        "artefact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artefact Sha256"
        },
        "artefact_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artefact Bytes"
        },
        "upstream_version_handle": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Version Handle"
        }
      },
      "required": [
        "name",
        "url",
        "retrieved_at"
      ],
      "title": "BatchSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^ingest-[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "adapter": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Adapter",
      "type": "string"
    },
    "adapter_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Adapter Version",
      "type": "string"
    },
    "run_started": {
      "format": "date-time",
      "title": "Run Started",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/BatchSource"
    },
    "licence": {
      "$ref": "#/$defs/BatchLicence"
    },
    "resolver_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resolver Snapshot Sha256",
      "type": "string"
    },
    "counts": {
      "patternProperties": {
        "^[a-z_]+$": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "Counts",
      "type": "object"
    },
    "target_tree": {
      "pattern": "^data/[a-z0-9_./-]+/$",
      "title": "Target Tree",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "id",
    "adapter",
    "adapter_version",
    "run_started",
    "source",
    "licence",
    "resolver_snapshot_sha256",
    "counts",
    "target_tree"
  ],
  "title": "IngestBatch",
  "type": "object"
}
