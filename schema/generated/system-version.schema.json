{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bench schema gen` from schema/*.py and taxonomy/*.yaml. Do not edit.",
  "additionalProperties": false,
  "properties": {
    "version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Version",
      "type": "string"
    },
    "released": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Released"
    },
    "api_identifier": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Api Identifier"
    },
    "deprecated": {
      "default": false,
      "title": "Deprecated",
      "type": "boolean"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "version"
  ],
  "title": "SystemVersion",
  "type": "object"
}
