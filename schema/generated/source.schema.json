{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bench schema gen` from schema/*.py and taxonomy/*.yaml. Do not edit.",
  "additionalProperties": false,
  "description": "04 S9's Source. Unknown keys are errors.\n\nThe fields after `notes` are not in 04 S9's example record. `archive_requested_at` and\n`failure_reason` are written by ingest/archive_sources.py (P1-S2-T08; 06 S7.3); `cited_by` is\nread by tools/build/feed.py. The rest were introduced by P0-S3-T04's draft Source records to\ndescribe what their extracts are, and are modelled so those records load; whether they stay is\nthat draft's review, and 04 S9 should list whichever do.",
  "properties": {
    "id": {
      "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "type": {
      "enum": [
        "paper",
        "preprint",
        "repository",
        "leaderboard-page",
        "dataset-card",
        "blog-post",
        "documentation",
        "dataset-export",
        "personal-communication",
        "regulatory-document"
      ],
      "title": "Type",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "url": {
      "pattern": "^https?://\\S+$",
      "title": "Url",
      "type": "string"
    },
    "doi": {
      "anyOf": [
        {
          "pattern": "^10\\.\\d{4,9}/\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "authors": {
      "anyOf": [
        {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authors"
    },
    "publisher": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publisher"
    },
    "published": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published"
    },
    "accessed": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accessed"
    },
    "fetched_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fetched At"
    },
    "archive_url": {
      "anyOf": [
        {
          "pattern": "^https?://\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archive Url"
    },
    "archive_captured": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archive Captured"
    },
    "archive_status": {
      "enum": [
        "ok",
        "pending",
        "failed",
        "not-required"
      ],
      "title": "Archive Status",
      "type": "string"
    },
    "archive_digest": {
      "anyOf": [
        {
          "pattern": "^[A-Z2-7]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archive Digest"
    },
    "content_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Sha256"
    },
    "quote_extract": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote Extract"
    },
    "licence_class": {
      "enum": [
        "permissive-attribution",
        "share-alike",
        "non-commercial",
        "no-redistribution",
        "unlicensed"
      ],
      "title": "Licence Class",
      "type": "string"
    },
    "licence_spdx": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Licence Spdx"
    },
    "licence_checked_on": {
      "format": "date",
      "title": "Licence Checked On",
      "type": "string"
    },
    "provenance": {
      "enum": [
        "primary",
        "pwc-archive",
        "hf_space_tag",
        "vendor-doc",
        "secondary"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "archive_requested_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archive Requested At"
    },
    "failure_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "cited_by": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Cited By",
      "type": "array"
    },
    "content_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Bytes"
    },
    "quote_extract_mode": {
      "anyOf": [
        {
          "enum": [
            "full",
            "windows"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote Extract Mode"
    },
    "quote_extract_basis": {
      "anyOf": [
        {
          "enum": [
            "normalised-text",
            "raw-body"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote Extract Basis"
    },
    "quote_extract_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote Extract Sha256"
    },
    "quote_extract_redactions": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote Extract Redactions"
    },
    "licence_basis": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Licence Basis"
    },
    "contains_personal_data": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contains Personal Data"
    },
    "drafted_by": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Drafted By"
    }
  },
  "required": [
    "id",
    "type",
    "url",
    "archive_status",
    "licence_class",
    "licence_checked_on",
    "provenance"
  ],
  "title": "Source",
  "type": "object"
}
