{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bench schema gen` from schema/*.py and taxonomy/*.yaml. Do not edit.",
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^base-[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "benchmark_version": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}(@[a-z0-9][a-z0-9._-]*)?$",
      "title": "Benchmark Version",
      "type": "string"
    },
    "kind": {
      "enum": [
        "human-crowd-average",
        "human-crowd-best",
        "human-expert-average",
        "human-expert-best",
        "theoretical-maximum",
        "measured-ceiling",
        "experimental-replicate",
        "operational-system",
        "noise-ceiling",
        "classical-algorithm",
        "random-chance",
        "field-practice-reference"
      ],
      "title": "Kind",
      "type": "string"
    },
    "metric": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Metric",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "value_absent_reason": {
      "anyOf": [
        {
          "enum": [
            "no-published-comparator",
            "not-applicable",
            "not-yet-measured"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value Absent Reason"
    },
    "n_humans": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "N Humans"
    },
    "population": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Population"
    },
    "time_limit": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time Limit"
    },
    "is_primary": {
      "default": false,
      "title": "Is Primary",
      "type": "boolean"
    },
    "source": {
      "anyOf": [
        {
          "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "id",
    "benchmark_version",
    "kind",
    "metric"
  ],
  "title": "Baseline",
  "type": "object"
}
